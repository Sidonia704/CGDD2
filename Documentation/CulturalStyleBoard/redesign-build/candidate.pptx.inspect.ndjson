{"kind":"textbox","id":"sh/4fi5s36x","slideIndex":0,"position":{"left":100,"top":721,"width":835,"height":40},"text":"Creative ownership","geometry":"rect","lineWidth":0,"style":{"fontSize":28,"typeface":"Arial","color":"#CB4A4F","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/p0rmloni","slideIndex":0,"position":{"left":100,"top":767,"width":835,"height":80},"text":"Arrange ordinary parts into a ship that expresses your own idea.","geometry":"rect","lineWidth":0,"style":{"fontSize":29,"typeface":"Arial","color":"#20262A","alignment":"left"}}
{"kind":"textbox","id":"sh/q1knuton","slideIndex":0,"position":{"left":100,"top":858,"width":835,"height":40},"text":"Learning through play","geometry":"rect","lineWidth":0,"style":{"fontSize":28,"typeface":"Arial","color":"#CB4A4F","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/r2t4ny58","slideIndex":0,"position":{"left":100,"top":904,"width":835,"height":80},"text":"Test a design, observe its weakness and change it.","geometry":"rect","lineWidth":0,"style":{"fontSize":29,"typeface":"Arial","color":"#20262A","alignment":"left"}}
