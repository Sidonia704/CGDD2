{"kind":"textbox","id":"sh/d4bmp8ne","slideIndex":0,"position":{"left":1000,"top":767,"width":850,"height":80},"text":"Balance armor, firepower, mass and energy within a fixed budget.","geometry":"rect","lineWidth":0,"style":{"fontSize":29,"typeface":"Arial","color":"#20262A","alignment":"left"}}
{"kind":"textbox","id":"sh/e5knydoz","slideIndex":0,"position":{"left":1000,"top":858,"width":850,"height":40},"text":"Persistence","geometry":"rect","lineWidth":0,"style":{"fontSize":28,"typeface":"Arial","color":"#CB4A4F","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/z6t4ri5k","slideIndex":0,"position":{"left":1000,"top":904,"width":850,"height":80},"text":"Keep the blueprint after failure and return with a better version.","geometry":"rect","lineWidth":0,"style":{"fontSize":29,"typeface":"Arial","color":"#20262A","alignment":"left"}}
