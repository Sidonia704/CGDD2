{"kind":"textbox","id":"sh/zah4b21g","slideIndex":0,"position":{"left":73,"top":140,"width":2800,"height":50},"text":"Cultural style board / modular construction, practical learning and the pleasure of making","geometry":"rect","lineWidth":0,"style":{"fontSize":29,"typeface":"Arial","color":"#657177","alignment":"left"}}
{"kind":"shape","id":"sh/y9832hkv","slideIndex":0,"position":{"left":70,"top":219,"width":2860,"height":363},"geometry":"rect","fillColor":"#FFFFFF","lineColor":"#C5C5C1","lineWidth":1.3}
{"kind":"textbox","id":"sh/tgjmhwji","slideIndex":0,"position":{"left":100,"top":248,"width":2780,"height":40},"text":"01  WHAT I NOTICED","geometry":"rect","lineWidth":0,"style":{"fontSize":28,"typeface":"Arial","color":"#CB4A4F","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/8fa58r2x","slideIndex":0,"position":{"left":100,"top":294,"width":2780,"height":76},"text":"I miss the freedom to build that I experienced in Robocraft and Minecraft, and I want to bring that creative excitement into my own game.","geometry":"rect","lineWidth":0,"style":{"fontSize":29,"typeface":"Arial","color":"#20262A","alignment":"left"}}
{"kind":"textbox","id":"sh/7e14fm1s","slideIndex":0,"position":{"left":100,"top":365,"width":2780,"height":40},"text":"02  CLAIM","geometry":"rect","lineWidth":0,"style":{"fontSize":28,"typeface":"Arial","color":"#CB4A4F","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/6d8n6hk7","slideIndex":0,"position":{"left":100,"top":411,"width":2780,"height":70},"text":"DIY culture gives players ownership and understanding through making, testing and improving their own spacecraft.","geometry":"rect","lineWidth":0,"style":{"fontSize":29,"typeface":"Arial","color":"#20262A","alignment":"left"}}
{"kind":"textbox","id":"sh/pkfm5sje","slideIndex":0,"position":{"left":100,"top":474,"width":2780,"height":40},"text":"03  PLAYER ACTIONS","geometry":"rect","lineWidth":0,"style":{"fontSize":28,"typeface":"Arial","color":"#CB4A4F","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/oj6lwn2t","slideIndex":0,"position":{"left":100,"top":520,"width":2780,"height":60},"text":"Assemble a ship; configure thrust; compare performance; diagnose failures; revise and save blueprints.","geometry":"rect","lineWidth":0,"style":{"fontSize":29,"typeface":"Arial","color":"#20262A","alignment":"left"}}
